# Settings for smstunnel-mcp. Your AI app passes them in the "env" of the MCP server config;
# this file only lists them. Never commit a real key.

# Required: a key from https://dashboard.smstunnel.io/apps (Apps → Add an app).
SMSTUNNEL_API_KEY=sk_live_your_key_here

# Optional: the phone that sends when a call doesn't name one (Phones → Copy in the dashboard).
# SMSTUNNEL_DEVICE_ID=

# Optional: completes numbers written without + or 00, e.g. +40 or 1.
# SMSTUNNEL_DEFAULT_COUNTRY_CODE=

# Optional, for testing only. Default https://smstunnel.io
# SMSTUNNEL_SERVER_URL=

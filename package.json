{
  "name": "@narcisbodea/smstunnel-mcp",
  "version": "1.0.0",
  "description": "SMSTunnel MCP server: AI apps send texts from your own Android phone and your own number.",
  "mcpName": "io.github.narcisbodea/smstunnel-mcp",
  "type": "module",
  "bin": {
    "smstunnel-mcp": "dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "smstunnel",
    "sms",
    "text-messages",
    "android",
    "own-number",
    "send-sms-from-computer",
    "2fa",
    "claude",
    "cursor",
    "ai-assistant"
  ],
  "author": {
    "name": "Narcis Bodea",
    "email": "contact@narboweb.ro"
  },
  "license": "MIT",
  "homepage": "https://github.com/narcisbodea/smstunnel-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narcisbodea/smstunnel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/narcisbodea/smstunnel-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
